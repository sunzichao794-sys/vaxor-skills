        "requestBody": { "$ref": "#/components/requestBodies/UploadFile" },
        "responses": { "201": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/instances/{instanceId}/assets/import": {
      "post": {
        "tags": ["Assets"],
        "operationId": "importAsset",
        "x-required-scopes": ["studio:assets:write"],
