      }
    },
    "/studio/runs/{runId}/events": {
      "get": {
        "tags": ["Runs"],
        "operationId": "listRunEvents",
        "x-required-scopes": ["studio:runs:read"],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/runs/{runId}/result": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRunResult",
        "x-required-scopes": ["studio:runs:read"],
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/requests/{idempotencyKey}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRequestStatus",
        "x-required-scopes": ["studio:runs:read"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKeyPath" }],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/exports/{exportId}": {
      "get": {
        "tags": ["Exports"],
        "operationId": "getExport",
        "x-required-scopes": ["studio:exports:read"],
        "parameters": [{ "$ref": "#/components/parameters/ExportId" }],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/exports/{exportId}/retry": {
      "post": {
        "tags": ["Exports"],
        "operationId": "retryExport",
        "x-required-scopes": ["studio:exports:write"],
        "parameters": [{ "$ref": "#/components/parameters/ExportId" }],
        "requestBody": { "$ref": "#/components/requestBodies/Record" },
        "responses": { "202": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/exports/{exportId}/download-ticket": {
      "post": {
        "tags": ["Exports"],
        "operationId": "createDownloadTicket",
        "x-required-scopes": ["studio:exports:read"],
        "parameters": [{ "$ref": "#/components/parameters/ExportId" }],
        "requestBody": { "$ref": "#/components/requestBodies/Record" },
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/schedules": {
      "get": {
        "tags": ["Schedules"],
        "operationId": "listSchedules",
        "x-required-scopes": ["studio:schedules:read"],
