      "patch": {
        "tags": ["Instances"],
        "operationId": "updateInstance",
        "x-required-scopes": ["studio:instances:write"],
        "parameters": [{ "$ref": "#/components/parameters/InstanceId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
