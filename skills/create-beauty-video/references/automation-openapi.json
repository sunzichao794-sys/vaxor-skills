        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/schedules/{scheduleId}": {
      "get": {
        "tags": ["Schedules"],
        "operationId": "getSchedule",
        "x-required-scopes": ["studio:schedules:read"],
        "parameters": [{ "$ref": "#/components/parameters/ScheduleId" }],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "patch": {
        "tags": ["Schedules"],
        "operationId": "updateSchedule",
        "x-required-scopes": ["studio:schedules:write"],
        "parameters": [{ "$ref": "#/components/parameters/ScheduleId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Record" },
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      },
      "delete": {
        "tags": ["Schedules"],
        "operationId": "deleteSchedule",
        "x-required-scopes": ["studio:schedules:write"],
        "parameters": [{ "$ref": "#/components/parameters/ScheduleId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/schedules/{scheduleId}/trigger": {
      "post": {
        "tags": ["Schedules"],
        "operationId": "triggerSchedule",
        "x-required-scopes": ["studio:schedules:write", "studio:runs:write"],
        "parameters": [{ "$ref": "#/components/parameters/ScheduleId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Record" },
        "responses": { "202": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Obtain an opaque token through the device-code flow."
      }
    },
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8 } },
      "IdempotencyKeyPath": { "name": "idempotencyKey", "in": "path", "required": true, "schema": { "type": "string" } },
      "InstanceId": { "name": "instanceId", "in": "path", "required": true, "schema": { "type": "string" } },
      "WorkflowInstanceId": { "name": "workflowInstanceId", "in": "path", "required": true, "schema": { "type": "string" } },
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } },
      "ExportId": { "name": "exportId", "in": "path", "required": true, "schema": { "type": "string" } },
      "ScheduleId": { "name": "scheduleId", "in": "path", "required": true, "schema": { "type": "string" } },
      "UploadId": { "name": "uploadId", "in": "path", "required": true, "schema": { "type": "string" } },
      "AssetType": { "name": "assetType", "in": "query", "required": true, "schema": { "type": "string", "enum": ["image", "video"] } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } }
    },
    "requestBodies": {
      "DeviceCodeRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceCodeRequest" } } } },
      "DeviceTokenRequest": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["deviceCode"], "properties": { "deviceCode": { "type": "string", "writeOnly": true } } } } } },
      "RefreshTokenRequest": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string", "writeOnly": true } } } } } },
      "RevokeTokenRequest": { "content": { "application/json": { "schema": { "type": "object", "properties": { "token": { "type": "string", "writeOnly": true } } } } } },
      "PlanEnvelope": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanEnvelope" } } } },
      "UploadRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadRequest" } } } },
      "UploadFile": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } },
      "ImportAssetRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportAssetRequest" } } } },
      "AssetPlacementRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssetPlacementRequest" } } } },
      "Record": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Record" } } } }
    },
    "responses": {
      "DeviceCodeResponse": { "description": "Device authorization request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceCodeResponse" } } } },
      "TokenResponse": { "description": "Short-lived access token and rotating refresh token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
      "UiLinks": { "description": "Server-built website links without bearer token parameters", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UiLinks" } } } },
      "Record": { "description": "Server-owned response record", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Record" } } } },
      "Success": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
      "Error": { "description": "Structured authorization, ownership, membership, credit, model, drift, or async error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
    },
    "schemas": {
      "DeviceCodeRequest": {
        "type": "object",
        "required": ["clientType", "clientInstanceId", "displayName", "scopes"],
        "properties": {
          "clientType": { "type": "string", "enum": ["codex", "chatgpt_work", "zcode", "workbuddy", "custom"] },
          "clientInstanceId": { "type": "string" },
          "displayName": { "type": "string" },
          "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      },
      "DeviceCodeResponse": {
        "type": "object",
        "required": ["deviceCode", "userCode", "verificationUri", "expiresIn", "interval"],
        "properties": {
          "deviceCode": { "type": "string", "writeOnly": true },
          "userCode": { "type": "string" },
          "verificationUri": { "type": "string", "format": "uri" },
          "verificationUriComplete": { "type": "string", "format": "uri" },
          "expiresIn": { "type": "integer" },
          "interval": { "type": "integer" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["accessToken", "refreshToken", "expiresIn", "scopes"],
        "properties": {
          "accessToken": { "type": "string", "writeOnly": true },
          "refreshToken": { "type": "string", "writeOnly": true },
          "tokenType": { "type": "string", "const": "Bearer" },
          "expiresIn": { "type": "integer" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "scopes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PlanEnvelope": {
        "type": "object",
        "required": ["plan"],
        "properties": {
          "plan": { "$ref": "#/components/schemas/VideoPlan" },
          "confirm": { "type": "boolean", "default": false },
          "maxCredits": { "type": ["integer", "null"] },
          "modelStrategy": { "type": "string" }
        }
      },
      "VideoPlan": {
        "type": "object",
        "required": ["workflowProfile", "profileVersion", "rulesHash", "shots"],
        "properties": {
          "workflowProfile": { "type": "string" },
          "promptProfile": { "type": ["string", "null"] },
          "profileVersion": { "type": "string" },
          "rulesHash": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64}|draft:.+)$" },
          "shots": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        },
        "additionalProperties": true
      },
      "UploadRequest": {
        "type": "object",
        "required": ["fileName", "mimeType", "sizeBytes"],
        "properties": {
          "fileName": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 314572800 },
          "title": { "type": "string" },
          "collectionId": { "type": "string" },
          "folderId": { "type": "string" }
        }
      },
      "ImportAssetRequest": {
        "type": "object",
        "required": ["sourceUrl"],
        "properties": {
          "sourceUrl": { "type": "string", "format": "uri", "description": "HTTP(S) image only" },
          "title": { "type": "string" },
          "collectionId": { "type": "string" },
          "folderId": { "type": "string" }
        }
      },
      "AssetPlacementRequest": {
        "type": "object",
        "required": ["operation", "assetKeys"],
        "properties": {
          "operation": { "type": "string", "enum": ["assign", "remove", "restore_default"] },
          "folderId": { "type": "string" },
          "assetKeys": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
          "expectedVersion": { "type": "integer", "minimum": 0 }
        }
      },
      "UiLinks": {
        "type": "object",
        "required": ["instanceUrl", "assetManagerUrl", "workflowUrl", "timelineUrl", "exportUrl"],
        "properties": {
          "instanceId": { "type": "string" },
          "instanceUrl": { "type": "string", "format": "uri" },
          "assetManagerUrl": { "type": "string", "format": "uri" },
          "workflowUrl": { "type": "string", "format": "uri" },
          "timelineUrl": { "type": "string", "format": "uri" },
          "exportUrl": { "type": "string", "format": "uri" }
        },
        "additionalProperties": true
      },
      "Record": { "type": "object", "additionalProperties": true },
      "Success": { "type": "object", "properties": { "success": { "type": "boolean" } }, "additionalProperties": true },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "stage", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "stage": { "type": "string" },
              "requestId": { "type": ["string", "null"] },
              "retryable": { "type": "boolean" },
              "retryAfterSeconds": { "type": ["integer", "null"] },
              "runId": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
