{
  "openapi": "3.1.0",
  "info": {
    "title": "Vaxor Automation API",
    "version": "0.1.0",
    "description": "Provider-neutral contract for authenticated video-production agents. The server owns authorization, billing, model validation, assets, workflow state, and exports."
  },
  "servers": [
    {
      "url": "{origin}/api/automation/v1",
      "variables": {
        "origin": {
          "default": "https://studio.example"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Authorization" },
    { "name": "Models" },
    { "name": "Instances" },
    { "name": "Assets" },
    { "name": "Workflows" },
    { "name": "Runs" },
    { "name": "Exports" },
    { "name": "Schedules" }
  ],
  "paths": {
    "/auth/device/code": {
      "post": {
        "tags": ["Authorization"],
        "operationId": "startDeviceAuthorization",
        "security": [],
        "x-required-scopes": [],
        "requestBody": { "$ref": "#/components/requestBodies/DeviceCodeRequest" },
        "responses": { "200": { "$ref": "#/components/responses/DeviceCodeResponse" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/device/token": {
      "post": {
        "tags": ["Authorization"],
        "operationId": "pollDeviceToken",
        "security": [],
        "x-required-scopes": [],
        "requestBody": { "$ref": "#/components/requestBodies/DeviceTokenRequest" },
        "responses": { "200": { "$ref": "#/components/responses/TokenResponse" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/token/refresh": {
      "post": {
        "tags": ["Authorization"],
        "operationId": "refreshToken",
        "security": [],
        "x-required-scopes": [],
        "requestBody": { "$ref": "#/components/requestBodies/RefreshTokenRequest" },
        "responses": { "200": { "$ref": "#/components/responses/TokenResponse" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/token/revoke": {
      "post": {
        "tags": ["Authorization"],
        "operationId": "revokeToken",
        "x-required-scopes": [],
        "requestBody": { "$ref": "#/components/requestBodies/RevokeTokenRequest" },
        "responses": { "200": { "$ref": "#/components/responses/Success" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Authorization"],
        "operationId": "getSession",
        "x-required-scopes": [],
        "responses": { "200": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/auth/connections": {
      "get": {
        "tags": ["Authorization"],
        "operationId": "listConnections",
