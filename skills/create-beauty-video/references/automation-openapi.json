      }
    },
    "/studio/workflows/{workflowInstanceId}/runs": {
      "post": {
        "tags": ["Runs"],
        "operationId": "startRun",
        "x-required-scopes": ["studio:runs:write"],
        "parameters": [{ "$ref": "#/components/parameters/WorkflowInstanceId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/Record" },
        "responses": { "202": { "$ref": "#/components/responses/Record" }, "default": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/studio/workflows/{workflowInstanceId}/schedules": {
      "post": {
        "tags": ["Schedules"],
        "operationId": "createSchedule",
        "x-required-scopes": ["studio:schedules:write"],
        "parameters": [{ "$ref": "#/components/parameters/WorkflowInstanceId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
